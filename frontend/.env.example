# Firebase Web Configuration for CodeX-RAY
# Create a free project at https://console.firebase.google.com/
# Enable Authentication -> Email/Password provider
# Enable Cloud Firestore -> Database -> Create Database

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Admin emails (comma-separated). Admins can inspect CodeX-RAY source and scan its core repository.
VITE_ADMIN_EMAILS=owner@example.com

